---
import SiteLayout from "../layouts/SiteLayout.astro";
import { contact } from "../data/contact";

/** Entries without `dates` are ones Brad cannot evidence to the year; the letters carry the dates instead. */
const roles: { title: string; organisation: string; dates?: string; summary: string; points: string[] }[] = [
  {
    title: "Independent consultant",
    organisation: "Clarity Engine AI and Pikle",
    dates: "2025–Now",
    summary: "Applied commercial, AI and product judgement to early-stage software work.",
    points: [
      "Built positioning, pricing, proposal templates and CRM stages.",
      "Defined four lead channels and produced a practical sales asset kit.",
      "Set UX audit priorities and brand/design governance.",
    ],
  },
  {
    title: "Sales and Marketing Manager, then General Manager",
    organisation: "NZ and Australia software channel",
    dates: "2015–2025",
    summary: "Ten years selling, demoing, proposing, forecasting, enabling and supporting a SaaS platform.",
    points: [
      "Grew licensed users from 2,800 to 24,500 across New Zealand and Australia.",
      "Managed full-cycle selling from prospecting and demos through proposals, pipeline, close and renewal.",
      "Built adoption strategy, enablement workshops and stakeholder communication so software moved from signed contract to everyday use.",
    ],
  },
  {
    title: "National Sales & Marketing Manager",
    organisation: "99 Corporation",
    dates: "2013–2015",
    summary: "Built the system behind a fourteen-person telemarketing team.",
    points: [
      "Created the process behind lead generation and sales calls.",
      "Scoped national accounts and developed the billing structure supporting cash flow.",
    ],
  },
  {
    title: "Business Development",
    organisation: "Xplore",
    dates: "2009–2013",
    summary: "Sold web, ecommerce and SaaS projects where positioning, usability, search and conversion had to line up.",
    points: [
      "Turned customer requirements into web strategy and practical proposals.",
      "Applied UI, UX and customer-experience judgement to the path from buyer interest to conversion.",
    ],
  },
  {
    title: "Senior Account Manager",
    organisation: "CanWest Media",
    summary: "Two and a half years developing and presenting new commercial ideas for Hawke's Bay accounts.",
    points: [
      "Consistently achieved monthly KPIs.",
      "Built proposals and presentations around specific ways to attract new business.",
    ],
  },
  {
    title: "Business Development",
    organisation: "Adplus Advertising (now Tracta)",
    summary: "Sold advertising and web services, with Hawke's Bay Tourism as a major account, working between publisher, advertisers and tourism leaders to build the market as well as the sale.",
    points: [
      "Developed advertiser relationships, customer records and campaign opportunities.",
      "Earned written references from both the managing director and the client general manager.",
    ],
  },
  {
    title: "Event Director",
    organisation: "2000AD",
    dates: "1999",
    summary: "Sold sponsorship, promoted and delivered a large public event.",
    points: [
      "Sold sponsors ten seconds of laser for thirty-six thousand dollars before production began.",
      "Delivered the event for fifteen thousand attendees.",
    ],
  },
];
---

<SiteLayout
  title="CV — Brad Friis"
  description="Brad Friis: commercial operator across SaaS growth, sales, revenue systems, product adoption and AI enablement."
>
  <div class="band">
  <header class="page-hero shell">
    <p class="eyebrow-pill">Curriculum vitae</p>
    <h1>Brad Friis</h1>
    <p class="page-intro">Commercial operator for SaaS growth: sales, revenue systems, product adoption and AI enablement.</p>
  </header>

  <div class="cv-layout shell">
    <aside class="cv-sidebar">
      <dl class="contact-list">
        <div>
          <dt>Location</dt>
          <dd>{contact.location}</dd>
        </div>
        <div>
          <dt>Email</dt>
          <dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd>
        </div>
        <div>
          <dt>Phone</dt>
          <dd><a href={contact.phoneHref}>{contact.phone}</a></dd>
        </div>
        <div>
          <dt>LinkedIn</dt>
          <dd><a href={contact.linkedin} rel="me">linkedin.com/in/bradfriis</a></dd>
        </div>
      </dl>
      <button class="button" type="button" data-print>Print or save PDF</button>
    </aside>

    <div>
      <section class="cv-section" aria-labelledby="cv-profile">
        <h2 id="cv-profile">Profile</h2>
        <p>I turn customer understanding into pipeline, proposals, adoption strategy and practical AI-enabled systems. My work spans full-cycle sales, SaaS strategy, revenue operations, product adoption and commercial product judgement.</p>
      </section>

      <section class="cv-section" aria-labelledby="cv-capabilities">
        <h2 id="cv-capabilities">Capabilities</h2>
        <ul class="chip-list">
          <li>Sales Growth</li>
          <li>SaaS Strategy</li>
          <li>Revenue Systems</li>
          <li>Product Adoption</li>
          <li>AI Enablement</li>
          <li>Proposals</li>
          <li>Pipeline Management</li>
          <li>UI, UX & CX Judgement</li>
        </ul>
      </section>

      <section class="cv-section" aria-labelledby="cv-experience">
        <h2 id="cv-experience">Commercial experience</h2>
        {roles.map((role) => (
          <article class="cv-entry">
            <h3>{role.title}</h3>
            <p class="meta">{role.dates ? `${role.organisation} · ${role.dates}` : role.organisation}</p>
            <p>{role.summary}</p>
            <ul>
              {role.points.map((point) => <li>{point}</li>)}
            </ul>
          </article>
        ))}
      </section>

      <section class="cv-section" aria-labelledby="cv-references">
        <h2 id="cv-references">References</h2>
        <p>Six written references span customers, clients and managers from 2003 to 2025, published in full. <a class="text-link" href="/letters/">Read the letters</a>.</p>
      </section>
    </div>
  </div>
  </div>
</SiteLayout>

<script>
  document.querySelector("[data-print]")?.addEventListener("click", () => window.print());
</script>
