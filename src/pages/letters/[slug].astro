---
import { Image } from "astro:assets";
import SiteLayout from "../../layouts/SiteLayout.astro";
import Transcription from "../../components/Transcription.astro";
import { letters } from "../../data/letters";

export function getStaticPaths() {
  return letters.map((letter, index) => ({
    params: { slug: letter.slug },
    props: {
      letter,
      previous: letters[index - 1],
      next: letters[index + 1],
    },
  }));
}

const { letter, previous, next } = Astro.props;
---

<SiteLayout
  title={`${letter.referee}, ${letter.organisation} — reference for Brad Friis`}
  description={`Full transcription of the ${letter.dateLabel} reference for Brad Friis from ${letter.referee}, ${letter.role}, ${letter.organisation}.`}
>
  <div class="band">
    <header class="page-hero shell">
      <a class="back-link" href="/letters/"><span class="back-link-arrow">←</span> All references</a>
      <p class="eyebrow-pill">{letter.documentType} · {letter.dateLabel}</p>
      <h1>{letter.referee}</h1>
      <p class="page-intro">{letter.role}, {letter.organisation}. <time datetime={letter.date}>{letter.dateLabel}</time>.</p>
    </header>

    <div class="letter-layout shell">
      <aside class="letter-meta">
        <p class="eyebrow-pill">About this document</p>
        <p class="context">{letter.context}</p>

        {letter.scans && <a class="text-link skip-to-scan" href="#scan">Jump to the scanned original ↓</a>}

        {letter.logo && (
          <div
            class={`letter-logo${letter.logo.image.width / letter.logo.image.height < 2.6 ? " is-stacked" : ""}`}
            style={`--logo-ratio: ${letter.logo.image.width} / ${letter.logo.image.height}`}
          >
            <Image src={letter.logo.image} alt={letter.logo.alt} widths={[180, 360]} sizes="180px" />
          </div>
        )}
      </aside>

      <div>
        <blockquote class="letter-pull-quote">“{letter.pullQuote}”</blockquote>

        <article class="transcription">
          <Transcription blocks={letter.body} />
        </article>

        {letter.scans && (
          <figure class="scan" id="scan">
            {letter.scans.map((page) => (
              <Image src={page.image} alt={page.alt} widths={[640, 960, 1280]} sizes="(max-width: 900px) calc(100vw - 28px), 560px" />
            ))}
            <figcaption>
              {letter.scans.length > 1
                ? `The original document, ${letter.scans.length} pages. Contact details are withheld.`
                : "The original document. Contact details are withheld."}
            </figcaption>
          </figure>
        )}

        <nav class="pager" aria-label="Other references">
          {previous ? (
            <a class="text-link" href={`/letters/${previous.slug}/`}>
              <span class="enum">Newer</span>{previous.referee}
            </a>
          ) : (
            <span></span>
          )}
          {next && (
            <a class="text-link" href={`/letters/${next.slug}/`}>
              <span class="enum">Older</span>{next.referee}
            </a>
          )}
        </nav>
      </div>
    </div>
  </div>
</SiteLayout>
