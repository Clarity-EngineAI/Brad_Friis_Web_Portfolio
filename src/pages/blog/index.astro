---
import SiteLayout from "../../layouts/SiteLayout.astro";
import ContactPanel from "../../components/ContactPanel.astro";
import { getPosts } from "../../lib/sanity";

const posts = await getPosts();
---

<SiteLayout
  title="Observations & stories — Brad Friis"
  description="Short, true stories from Brad Friis — unrelated to the sales pitch, published as written."
>
  <div class="band">
    <header class="page-hero shell">
      <p class="eyebrow-pill">Observations</p>
      <h1>A few things that happened.</h1>
      <p class="page-intro">Stories, published as written. Nothing here is a pitch — but the way I notice and solve problems shows up in them too.</p>
    </header>

    <section class="letter-index blog-index shell" aria-label="Blog posts">
      {posts.length === 0 && <p>Nothing published yet.</p>}
      <ol class="row-list">
        {posts.map((post) => (
          <li class="letter-row">
            <div class="letter-who">
              <p class="tier-name">
                <a href={`/blog/${post.slug}/`}>{post.title}</a>
              </p>
              <p class="tier-meta">{post.category} · <time datetime={post.date}>{post.dateLabel}</time></p>
            </div>
            <div class="letter-quote">
              <p class="dek">{post.dek}</p>
              <a class="text-link" href={`/blog/${post.slug}/`}>
                Read<span class="visually-hidden"> {post.title}</span>
              </a>
            </div>
          </li>
        ))}
      </ol>
    </section>
  </div>

  <div class="band band-alt">
    <section class="section shell" id="contact" aria-labelledby="contact-heading">
      <ContactPanel
        eyebrow="Get in touch"
        heading="Say hello."
        disciplines="No pitch, no form to fill in for its own sake — just a way to reach me."
      />
    </section>
  </div>
</SiteLayout>
