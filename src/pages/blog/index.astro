---
import SiteLayout from "../../layouts/SiteLayout.astro";
import ContactPanel from "../../components/ContactPanel.astro";
import { getPosts } from "../../lib/sanity";

const posts = await getPosts();
---

<SiteLayout
  title="Observations & stories — Brad Friis"
  description="Short, true stories from Brad Friis — unrelated to the sales pitch, published as written."
>
  <div class="band">
    <header class="page-hero shell">
      <p class="eyebrow-pill">Observations & stories</p>
      <h1>A few things that happened.</h1>
      <p class="page-intro">Stories, published as written. Nothing here is a pitch.</p>
    </header>

    <section class="letter-index shell" aria-label="Blog posts">
      <ol class="row-list">
        {posts.map((post) => (
          <li class="letter-row">
            <div class="letter-who">
              <p class="tier-name">
                <a href={`/blog/${post.slug}/`}>{post.title}</a>
              </p>
              <p class="tier-meta">{post.category}</p>
              <p class="tier-meta"><time datetime={post.date}>{post.dateLabel}</time></p>
            </div>
            <div class="letter-quote">
              <blockquote>{post.dek}</blockquote>
              <a class="text-link" href={`/blog/${post.slug}/`}>
                Read<span class="visually-hidden"> {post.title}</span>
              </a>
            </div>
          </li>
        ))}
      </ol>
    </section>
  </div>

  <div class="band band-alt">
    <section class="section shell" id="contact" aria-labelledby="contact-heading">
      <ContactPanel />
    </section>
  </div>
</SiteLayout>
