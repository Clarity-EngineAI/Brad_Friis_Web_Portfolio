---
import { Image } from "astro:assets";
import SiteLayout from "../../layouts/SiteLayout.astro";
import BlogBody from "../../components/BlogBody.astro";
import { getBlogImage } from "../../data/blogImages";
import { getPosts } from "../../lib/sanity";

export async function getStaticPaths() {
  const posts = await getPosts();

  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      previous: posts[index - 1],
      next: posts[index + 1],
    },
  }));
}

const { post, previous, next } = Astro.props;
const leadImage = post.image ? getBlogImage(post.image.key) : null;
---

<SiteLayout
  title={`${post.title} — Brad Friis`}
  description={post.dek}
>
  <div class="band">
    <header class="page-hero shell">
      <a class="back-link" href="/blog/"><span class="back-link-arrow">←</span> All posts</a>
      <p class="eyebrow-pill">{post.category} · {post.dateLabel}</p>
      <h1>{post.title}</h1>
      <p class="page-intro">{post.dek}</p>
    </header>

    <div class="shell">
      <article class="blog-post">
        {leadImage && post.image && (
          <figure class="blog-figure blog-figure-lead">
            <Image src={leadImage} alt={post.image.alt} widths={[640, 960, 1280]} sizes="(min-width: 48rem) 40rem, 100vw" />
            {post.image.caption && <figcaption>{post.image.caption}</figcaption>}
          </figure>
        )}
        <BlogBody blocks={post.body} />
      </article>

      <nav class="pager" aria-label="Other posts">
        {previous && (
          <a class="text-link" href={`/blog/${previous.slug}/`}>
            <span class="enum newer"><span class="back-link-arrow">←</span>Newer</span>{previous.title}
          </a>
        )}
        {next && (
          <a class="text-link" href={`/blog/${next.slug}/`}>
            <span class="enum">Older<span class="back-link-arrow">→</span></span>{next.title}
          </a>
        )}
      </nav>
    </div>
  </div>
</SiteLayout>
