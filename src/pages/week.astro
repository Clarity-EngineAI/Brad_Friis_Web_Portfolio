---
import { Image } from "astro:assets";
import SiteLayout from "../layouts/SiteLayout.astro";
import BookingButton from "../components/BookingButton.astro";
import { isStackedWeekLogo, weekLogos } from "../data/weekLogos";
import { categories, pillars, vocabulary } from "../data/repWeekCalendar.js";
import "../styles/week.css";

/* Growth: the book expanding. Delivery: stood up and in use. Operations: vendor, team and commercial as one system. */
const pillarMarks: Record<(typeof vocabulary.pillars)[number], string> = {
  growth:
    '<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2 12.5c2.4.1 3.5-4 6.1-6.3L13.2 3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M9.1 3.1h4.1V7.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  delivery:
    '<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="2.2" y="3.1" width="11.6" height="9.8" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M5.2 8.3 7.15 10.2 10.9 5.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  operations:
    '<svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="3.35" r="1.7" fill="currentColor"/><circle cx="3.25" cy="12.45" r="1.7" fill="currentColor"/><circle cx="12.75" cy="12.45" r="1.7" fill="currentColor"/><path d="M7.1 4.85 4.2 10.85M8.9 4.85l2.9 6M4.95 12.45h6.1" fill="none" stroke="currentColor" stroke-width="1.45"/></svg>',
};
---

<SiteLayout
  title="A week in the job — Brad Friis"
  description="A representative week from a ten-year channel partnership with a major K-12 education technology provider — selling, implementing and supporting its solutions in New Zealand and Australian schools."
>
  <section class="week-hero shell">
    <p class="eyebrow-pill">Representative week</p>
    <h1>A week in the job.</h1>
    <p class="hero-lead">
      I managed a ten-year channel partnership with one of the largest K-12 education
      technology providers in the United States. My role was to design and execute every
      strategy needed to sell, implement, support and maintain its solutions in
      New Zealand and Australian schools.
    </p>
    <p class="career-quote week-pullquote">
      <span class="career-quote-text">
        “Brad is a trusted and well-respected figure across the New Zealand edtech community
        whose expert guidance transformed our digital ecosystem.”
      </span>
      <span class="career-quote-source">Lawrence Naicker — Deputy Principal, Sancta Maria College</span>
    </p>
  </section>

  <section class="filter-section shell" aria-labelledby="filter-heading">
    <div class="week-menu" id="week-menu">
      <div class="week-menu-bar">
        <div class="week-menu-primary">
          <h2 id="filter-heading" class="week-menu-kicker">View the week</h2>
          <div class="week-menu-triggers" role="menubar" aria-label="Filter the week by area">
            {vocabulary.pillars.map((pillarId) => {
              const pillar = pillars[pillarId as keyof typeof pillars];
              return (
                <div
                  class="week-menu-item"
                  data-menu-item={pillarId}
                  style={`--pillar-color: var(--p-${pillarId}); --pillar-wash: var(--wash-${pillarId});`}
                >
                  <button
                    class="week-menu-trigger"
                    type="button"
                    data-menu-trigger={pillarId}
                    data-state="none"
                    aria-haspopup="true"
                    aria-expanded="false"
                    aria-controls={`week-menu-panel-${pillarId}`}
                  >
                    <span class="week-menu-swatch" aria-hidden="true" set:html={pillarMarks[pillarId]} />
                    <span class="week-menu-copy">
                      <span class="week-menu-name">{pillar.label}</span>
                      <span class="week-menu-count" data-menu-count={pillarId} hidden></span>
                    </span>
                    <svg class="week-menu-chevron" viewBox="0 0 12 12" aria-hidden="true">
                      <path
                        d="M2.5 4.5 6 8l3.5-3.5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </button>
                  <div class="week-menu-panel" id={`week-menu-panel-${pillarId}`} role="menu" hidden>
                    <div class="week-menu-panel-head">
                      <p class="week-menu-panel-title">{pillar.label}</p>
                      <p class="week-menu-panel-standfirst">{pillar.standfirst}</p>
                    </div>
                    <div class="week-menu-options">
                      {pillar.categories.map((catId: string) => (
                        <button
                          class="week-menu-option"
                          type="button"
                          role="menuitemcheckbox"
                          data-cat-toggle={catId}
                          aria-checked="false"
                          style={`--cat-color: var(--c-${catId}); --cat-wash: var(--wash-${pillarId});`}
                        >
                          <span class="week-menu-check" aria-hidden="true"></span>
                          <span class="week-menu-option-dot" aria-hidden="true"></span>
                          <span class="week-menu-option-label">{categories[catId].label}</span>
                        </button>
                      ))}
                    </div>
                    <div class="week-menu-panel-foot">
                      <button class="week-menu-foot-action" type="button" data-pillar-toggle={pillarId}>
                        All {pillar.label}
                      </button>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
        <div class="week-menu-meta">
          <p class="week-menu-status" data-filter-status aria-live="polite">The full week</p>
          <button
            class="week-menu-revert"
            type="button"
            data-reset
            hidden
          >
            Show the full week
          </button>
        </div>
      </div>
      <div class="week-menu-chips" data-active-chips hidden></div>
    </div>
  </section>

  <section class="calendar-section shell" aria-labelledby="week-heading">
    <h2 id="week-heading" class="visually-hidden">The week</h2>
    <div class="week-grid" id="week-grid"></div>
    <div class="agenda" id="agenda"></div>
  </section>

  <section class="shell logo-strip week-logo-strip" aria-labelledby="week-logos-heading">
    <p class="eyebrow-pill" id="week-logos-heading">Schools from this partnership</p>
    <p class="logo-note">A sample of the schools and organisations this work touched. Not current clients, and not an endorsement.</p>
    <ul aria-label="Schools and organisations from the PowerSchool partnership">
      {weekLogos.map((logo) => (
        <li>
          <Image
            class:list={{ "logo-stacked": isStackedWeekLogo(logo) }}
            src={logo.image}
            alt={logo.name}
            height={isStackedWeekLogo(logo) ? 80 : 60}
            loading="lazy"
          />
        </li>
      ))}
    </ul>
  </section>

  <section class="pillar-section shell" aria-labelledby="pillars-heading">
    <h2 id="pillars-heading" class="week-zone-label">The three pillars</h2>
    <div class="pillar-key">
      <div class="pillar-cell" style="--pillar-color: var(--p-growth); --pillar-wash: var(--wash-growth); --pillar-fill: var(--fill-growth);">
        <div class="pillar-cell-head">
          <h3>Growth</h3>
        </div>
        <p>Finding the right schools, winning them, and keeping them at renewal time.</p>
        <ul class="pillar-cats">
          <li style="--dot: var(--c-pipeline);">Pipeline and renewals</li>
          <li style="--dot: var(--c-targeting);">Data and targeting</li>
          <li style="--dot: var(--c-campaigns);">Campaigns and launches</li>
          <li style="--dot: var(--c-measurement);">Measurement and attribution</li>
        </ul>
      </div>

      <div class="pillar-cell" style="--pillar-color: var(--p-delivery); --pillar-wash: var(--wash-delivery); --pillar-fill: var(--fill-delivery);">
        <div class="pillar-cell-head">
          <h3>Delivery</h3>
        </div>
        <p>Getting schools set up, trained and confident enough that the platform actually got used.</p>
        <ul class="pillar-cats">
          <li style="--dot: var(--c-implementation);">Technical implementation</li>
          <li style="--dot: var(--c-enablement);">Customer enablement</li>
          <li style="--dot: var(--c-learning-design);">Learning design and facilitation</li>
          <li style="--dot: var(--c-support);">Support and service design</li>
        </ul>
      </div>

      <div class="pillar-cell" style="--pillar-color: var(--p-operations); --pillar-wash: var(--wash-operations); --pillar-fill: var(--fill-operations);">
        <div class="pillar-cell-head">
          <h3>Operations</h3>
        </div>
        <p>The money, the contracts, the vendor relationship and the team behind all of it.</p>
        <ul class="pillar-cats">
          <li style="--dot: var(--c-commercial);">Commercial and finance</li>
          <li style="--dot: var(--c-partnerships);">Partnerships and suppliers</li>
          <li style="--dot: var(--c-people);">People and resourcing</li>
          <li style="--dot: var(--c-systems);">Systems and governance</li>
        </ul>
      </div>
    </div>
    <p class="week-hero-note">
      Beyond the platform partnership itself, no employer, customer, school or contract is
      named here, and no figures are given. The work is described at the level of what it
      required, which is the part that transfers.
    </p>
  </section>

  <section class="week-close-section shell">
    <h2>That's the shape of the job.</h2>
    <p class="hero-lead">
      One person held all of this, every week, for ten years. If some of it looks like
      work you need done, I'd enjoy the conversation.
    </p>
    <div class="week-close-actions">
      <BookingButton variant="hero" label="Book a conversation" />
      <a class="button button-secondary" href="/cv/">Back to the CV</a>
      <a class="text-link" href="/letters/">Read the reference letters</a>
    </div>
  </section>

  <dialog class="detail-dialog" id="detail-dialog" tabindex="-1" aria-labelledby="detail-title">
    <div class="sheet-handle" aria-hidden="true"></div>
    <button class="detail-close" type="button" data-close aria-label="Close detail">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M1 1L13 13M13 1L1 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
    </button>
    <div class="detail-inner">
      <button class="detail-back" type="button" id="detail-back" hidden>
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M7.5 1.5L3 6l4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span id="detail-back-label"></span>
      </button>
      <p class="detail-eyebrow" id="detail-eyebrow"></p>
      <h2 id="detail-title"></h2>
      <p id="detail-copy"></p>
      <p id="detail-related"></p>
      <div class="detail-links-block" id="detail-links-block" hidden>
        <span class="week-t-label">Connected work</span>
        <div class="detail-links" id="detail-links"></div>
      </div>
      <button class="detail-close-foot" type="button" data-close>Close</button>
    </div>
  </dialog>
</SiteLayout>

<script>
  import { calendarEntries, categories, pillars, vocabulary } from "../data/repWeekCalendar.js";

  const pillarsByKey = pillars as Record<string, (typeof pillars)[keyof typeof pillars]>;
  const categoriesByKey = categories as Record<string, (typeof categories)[keyof typeof categories]>;

  const dayLabels: Record<string, string> = {
    monday: "Monday",
    tuesday: "Tuesday",
    wednesday: "Wednesday",
    thursday: "Thursday",
    friday: "Friday",
  };

  const slotLabels: Record<string, string> = { morning: "AM", afternoon: "PM" };

  function slotShort(slot: string) {
    return slot === "morning" ? "AM" : "PM";
  }

  const state = {
    activeCategories: new Set<string>(),
    selectedId: null as string | null,
    trail: [] as string[],
    openMenu: null as string | null,
  };

  const allCategoryIds = Object.keys(categories);
  const noSelection = () => state.activeCategories.size === 0;
  const everythingSelected = () => state.activeCategories.size === allCategoryIds.length;

  const el = {
    grid: document.querySelector("#week-grid")!,
    agenda: document.querySelector("#agenda")!,
    status: document.querySelector<HTMLElement>("[data-filter-status]")!,
    chips: document.querySelector<HTMLElement>("[data-active-chips]")!,
    resetButton: document.querySelector<HTMLButtonElement>("[data-reset]")!,
    dialog: document.querySelector<HTMLDialogElement>("#detail-dialog")!,
    panelTitle: document.querySelector("#detail-title")!,
    panelEyebrow: document.querySelector("#detail-eyebrow")!,
    panelCopy: document.querySelector("#detail-copy")!,
    panelRelated: document.querySelector("#detail-related")!,
    panelLinks: document.querySelector("#detail-links")!,
    panelLinksBlock: document.querySelector<HTMLElement>("#detail-links-block")!,
    backButton: document.querySelector<HTMLButtonElement>("#detail-back")!,
    backLabel: document.querySelector("#detail-back-label")!,
  };

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const desktopQuery = window.matchMedia("(min-width: 62rem)");
  const byId = new Map(calendarEntries.map((entry) => [entry.id, entry]));

  document.documentElement.classList.add("js-ready");

  const pillarOf = (entry: (typeof calendarEntries)[number]) => categoriesByKey[entry.category].pillar;

  function pillarState(pillarId: string) {
    const children = pillarsByKey[pillarId].categories;
    const on = children.filter((id) => state.activeCategories.has(id)).length;
    if (on === 0) return "none";
    if (on === children.length) return "all";
    return "some";
  }

  function visibleEntries() {
    if (noSelection()) return calendarEntries;
    return calendarEntries.filter((entry) => state.activeCategories.has(entry.category));
  }

  function linkedIds() {
    if (!state.selectedId) return new Set<string>();
    const selected = byId.get(state.selectedId)!;
    const ids = new Set(selected.connections);
    for (const entry of calendarEntries) {
      if (entry.connections.includes(selected.id)) ids.add(entry.id);
    }
    ids.delete(selected.id);
    return ids;
  }

  function escapeHtml(value: string) {
    return value.replace(
      /[&<>"']/g,
      (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[character]!,
    );
  }

  function catVars(categoryId: string) {
    const pillar = categoriesByKey[categoryId].pillar;
    return `--cat-color: var(--c-${categoryId}); --cat-wash: var(--wash-${pillar}); --cat-fill: var(--fill-${pillar});`;
  }

  function entryMarkup(entry: (typeof calendarEntries)[number], linked: boolean, { showSlot = false } = {}) {
    const selected = state.selectedId === entry.id;
    const category = categoriesByKey[entry.category];
    const pillar = pillarOf(entry);
    const linkNote = linked ? " Connected to the open entry." : "";

    return `
      <button
        class="entry${linked ? " is-linked" : ""}"
        type="button"
        style="${catVars(entry.category)} --pillar-on-dark: var(--p-${pillar}-on-dark);"
        data-entry="${entry.id}"
        aria-expanded="${selected}"
        aria-controls="detail-dialog"
        aria-label="${escapeHtml(
          `${dayLabels[entry.day]} ${slotShort(entry.slot)}. ${entry.title}. ${category.label}, under ${pillarsByKey[pillar].label}.${linkNote}`,
        )}"
      >
        <span class="entry-cat">${escapeHtml(category.shortLabel)}${
          showSlot ? `<span class="entry-slot">${slotShort(entry.slot)}</span>` : ""
        }</span>
        <span class="entry-title">${escapeHtml(entry.title)}</span>
        <span class="entry-summary">${escapeHtml(entry.summary)}</span>
      </button>
    `;
  }

  function closeMenu({ restoreFocus = false } = {}) {
    const previous = state.openMenu;
    state.openMenu = null;
    document.querySelectorAll<HTMLElement>(".week-menu-item").forEach((item) => {
      item.classList.remove("is-open");
      const trigger = item.querySelector<HTMLButtonElement>("[data-menu-trigger]");
      const panel = item.querySelector<HTMLElement>(".week-menu-panel");
      if (trigger) trigger.setAttribute("aria-expanded", "false");
      if (panel) panel.hidden = true;
    });
    if (restoreFocus && previous) {
      document.querySelector<HTMLButtonElement>(`[data-menu-trigger="${previous}"]`)?.focus();
    }
  }

  function openMenu(pillarId: string) {
    if (state.openMenu === pillarId) {
      closeMenu();
      return;
    }
    closeMenu();
    state.openMenu = pillarId;
    const item = document.querySelector<HTMLElement>(`[data-menu-item="${pillarId}"]`);
    const trigger = item?.querySelector<HTMLButtonElement>("[data-menu-trigger]");
    const panel = item?.querySelector<HTMLElement>(".week-menu-panel");
    if (!item || !trigger || !panel) return;
    item.classList.add("is-open");
    trigger.setAttribute("aria-expanded", "true");
    panel.hidden = false;
  }

  function menuOptions(pillarId: string) {
    const panel = document.querySelector(`#week-menu-panel-${pillarId}`);
    return panel ? [...panel.querySelectorAll<HTMLButtonElement>("[data-cat-toggle]")] : [];
  }

  function renderFilters() {
    el.resetButton.hidden = noSelection();

    const selectedCount = state.activeCategories.size;
    if (noSelection()) el.status.textContent = "The full week";
    else if (everythingSelected()) el.status.textContent = "All 12 areas";
    else el.status.textContent = `${selectedCount} of 12 areas`;

    vocabulary.pillars.forEach((pillarId) => {
      const status = pillarState(pillarId);
      const trigger = document.querySelector<HTMLButtonElement>(`[data-menu-trigger="${pillarId}"]`);
      const count = document.querySelector<HTMLElement>(`[data-menu-count="${pillarId}"]`);
      const on = pillarsByKey[pillarId].categories.filter((id) => state.activeCategories.has(id)).length;
      if (trigger) {
        trigger.dataset.state = status;
        const label = pillarsByKey[pillarId].label;
        const stateCopy =
          status === "all"
            ? `All four ${label} areas selected.`
            : status === "some"
              ? `${on} of four ${label} areas selected.`
              : `${label} menu.`;
        trigger.setAttribute("aria-label", `${label}. ${stateCopy}`);
      }
      if (count) {
        if (status === "none") {
          count.hidden = true;
          count.textContent = "";
        } else {
          count.hidden = false;
          count.textContent = `${on}/4`;
        }
      }

      const foot = document.querySelector<HTMLButtonElement>(
        `[data-menu-item="${pillarId}"] [data-pillar-toggle]`,
      );
      if (foot) foot.textContent = status === "all" ? `Clear ${pillarsByKey[pillarId].label}` : `All ${pillarsByKey[pillarId].label}`;

      pillarsByKey[pillarId].categories.forEach((catId) => {
        const option = document.querySelector<HTMLButtonElement>(`[data-cat-toggle="${catId}"]`);
        if (!option) return;
        const onCat = state.activeCategories.has(catId);
        option.setAttribute("aria-checked", String(onCat));
      });
    });

    if (noSelection() || everythingSelected()) {
      el.chips.hidden = true;
      el.chips.innerHTML = "";
      return;
    }

    el.chips.hidden = false;
    el.chips.innerHTML = [...state.activeCategories]
      .map((catId) => {
        const category = categoriesByKey[catId];
        return `
          <button
            class="week-menu-chip"
            type="button"
            data-chip-remove="${catId}"
            style="${catVars(catId)}"
            aria-label="${escapeHtml(`Remove ${category.label}`)}"
          >
            <span class="week-menu-option-dot" aria-hidden="true"></span>
            ${escapeHtml(category.chipLabel)}
            <svg viewBox="0 0 12 12" aria-hidden="true">
              <path d="M3 3l6 6M9 3L3 9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
            </svg>
          </button>`;
      })
      .join("");
  }

  function render() {
    const entries = visibleEntries();
    const linked = linkedIds();

    el.grid.innerHTML = `
      <div class="grid-corner" aria-hidden="true"></div>
      ${vocabulary.days.map((day) => `<div class="day-head"><h3>${dayLabels[day]}</h3></div>`).join("")}
      ${vocabulary.slots
        .map(
          (slot) => `
        <div class="slot-head"><span>${slotLabels[slot]}</span></div>
        ${vocabulary.days
          .map((day) => {
            const cell = entries.filter((entry) => entry.day === day && entry.slot === slot);
            return `<div class="grid-cell">${cell
              .map((entry) => entryMarkup(entry, linked.has(entry.id)))
              .join("")}</div>`;
          })
          .join("")}`,
        )
        .join("")}
    `;

    el.agenda.innerHTML = vocabulary.days
      .map((day) => {
        const dayEntries = entries.filter((entry) => entry.day === day);
        if (!dayEntries.length) return "";
        const slots = vocabulary.slots
          .map((slot) => {
            const slotEntries = dayEntries.filter((entry) => entry.slot === slot);
            if (!slotEntries.length) return "";
            return `
            <div class="agenda-slot">
              <h4 class="agenda-slot-head">${slotLabels[slot]}</h4>
              ${slotEntries.map((entry) => entryMarkup(entry, linked.has(entry.id))).join("")}
            </div>`;
          })
          .join("");
        return `
        <section class="agenda-day" aria-labelledby="agenda-${day}">
          <header class="agenda-day-head">
            <h3 id="agenda-${day}">${dayLabels[day]}</h3>
          </header>
          ${slots}
        </section>`;
      })
      .join("");
  }

  function openDetail(id: string, { focusPanel = true, from = null as string | null } = {}) {
    const entry = byId.get(id);
    if (!entry) return;

    if (from) state.trail.push(from);
    else state.trail.length = 0;
    const category = categoriesByKey[entry.category];
    const pillar = pillarOf(entry);

    state.selectedId = id;
    el.dialog.setAttribute("style", `${catVars(entry.category)} --pillar-on-dark: var(--p-${pillar}-on-dark);`);

    el.panelEyebrow.innerHTML = `<span class="dot" aria-hidden="true"></span>${escapeHtml(
      category.label,
    )}<span class="detail-pillar-tag">${escapeHtml(pillarsByKey[pillar].label)} · ${dayLabels[entry.day]} ${
      slotShort(entry.slot)
    }</span>`;
    el.panelTitle.textContent = entry.title;
    el.panelCopy.textContent = entry.detail;

    const related = entry.alsoRanInto.map((pillarId) => pillarsByKey[pillarId].label);
    el.panelRelated.textContent = related.length
      ? `This work also ran into ${related.join(" and ")}.`
      : "Contained entirely within this pillar.";

    const cameFrom = state.trail.length ? byId.get(state.trail[state.trail.length - 1]) : null;
    el.backButton.hidden = !cameFrom;
    el.backLabel.textContent = cameFrom ? `Back to ${cameFrom.title}` : "";
    if (cameFrom) el.backButton.setAttribute("aria-label", `Back to ${cameFrom.title}`);
    else el.backButton.removeAttribute("aria-label");

    const connections = entry.connections.map((cid) => byId.get(cid)).filter(Boolean) as typeof calendarEntries;
    el.panelLinksBlock.hidden = connections.length === 0;
    el.panelLinks.innerHTML = connections
      .map(
        (connection) =>
          `<button class="detail-link" type="button" data-goto="${connection.id}"
             style="--link-color: var(--c-${connection.category});">
             <span class="dot" aria-hidden="true"></span>
             <span class="detail-link-text">
               <span class="detail-link-title">${escapeHtml(connection.title)}</span>
               <span class="detail-link-where">${dayLabels[connection.day]} ${slotShort(connection.slot)} · ${escapeHtml(
                 categoriesByKey[connection.category].shortLabel,
               )}</span>
             </span></button>`,
      )
      .join("");

    if (!el.dialog.open) el.dialog.showModal();
    render();

    if (focusPanel) el.dialog.focus({ preventScroll: true });
  }

  function closeDetail({ restoreFocus = true } = {}) {
    const originId = state.selectedId;
    if (!originId) return;
    state.selectedId = null;
    state.trail.length = 0;
    if (el.dialog.open) el.dialog.close();
    render();

    if (restoreFocus && originId) {
      requestAnimationFrame(() => {
        const candidates = document.querySelectorAll(`[data-entry="${CSS.escape(originId)}"]`);
        const visible = [...candidates].find((element) => (element as HTMLElement).offsetParent !== null) as
          | HTMLElement
          | undefined;
        if (!visible) return;
        visible.focus({ preventScroll: true });
        visible.scrollIntoView({
          block: "nearest",
          behavior: reducedMotion.matches ? "auto" : "smooth",
        });
        visible.classList.remove("just-visited");
        void visible.offsetWidth;
        visible.classList.add("just-visited");
        visible.addEventListener("animationend", () => visible.classList.remove("just-visited"), { once: true });
      });
    }
  }

  function reconcileSelection() {
    if (noSelection() || !state.selectedId) return;
    if (!state.activeCategories.has(byId.get(state.selectedId)!.category)) {
      closeDetail({ restoreFocus: false });
    }
  }

  function togglePillar(pillarId: string) {
    const children = pillarsByKey[pillarId].categories;
    const turnOn = pillarState(pillarId) !== "all";
    children.forEach((id) => {
      if (turnOn) state.activeCategories.add(id);
      else state.activeCategories.delete(id);
    });
    commit();
  }

  function toggleCategory(catId: string) {
    if (state.activeCategories.has(catId)) state.activeCategories.delete(catId);
    else state.activeCategories.add(catId);
    commit();
  }

  function reset() {
    state.activeCategories.clear();
    commit();
  }

  function eventInsideOpenMenu(event: Event) {
    if (!state.openMenu) return false;
    const item = document.querySelector(`[data-menu-item="${state.openMenu}"]`);
    const target = event.target;
    return Boolean(item && target instanceof Node && item.contains(target));
  }

  function dismissMenuIfOutside(event: Event) {
    if (!state.openMenu) return;
    if (!eventInsideOpenMenu(event)) closeMenu();
  }

  function commit() {
    reconcileSelection();
    renderFilters();
    render();
  }

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;

    const menuTrigger = target.closest<HTMLElement>("[data-menu-trigger]");
    if (menuTrigger) return openMenu(menuTrigger.dataset.menuTrigger!);

    const chipRemove = target.closest<HTMLElement>("[data-chip-remove]");
    if (chipRemove) {
      state.activeCategories.delete(chipRemove.dataset.chipRemove!);
      return commit();
    }

    const pillarButton = target.closest<HTMLElement>("[data-pillar-toggle]");
    if (pillarButton) return togglePillar(pillarButton.dataset.pillarToggle!);

    const catButton = target.closest<HTMLElement>("[data-cat-toggle]");
    if (catButton) return toggleCategory(catButton.dataset.catToggle!);

    if (target.closest("[data-reset]")) {
      closeMenu();
      return reset();
    }

    const entryButton = target.closest<HTMLElement>("[data-entry]");
    if (entryButton) {
      const id = entryButton.dataset.entry!;
      closeMenu();
      return id === state.selectedId ? closeDetail() : openDetail(id);
    }

    if (target.closest("#detail-back")) {
      const previous = state.trail.pop();
      if (previous) openDetail(previous);
      return;
    }

    const goto = target.closest<HTMLElement>("[data-goto]");
    if (goto) return openDetail(goto.dataset.goto!, { from: state.selectedId });

    if (target.closest("[data-close]")) return closeDetail();
  });

  document.addEventListener("pointerdown", dismissMenuIfOutside, true);
  document.addEventListener("focusin", dismissMenuIfOutside);

  document.addEventListener("keydown", (event) => {
    const target = event.target as HTMLElement;

    if (event.key === "Escape" && state.openMenu) {
      event.preventDefault();
      closeMenu({ restoreFocus: true });
      return;
    }

    const trigger = target.closest<HTMLElement>("[data-menu-trigger]");
    if (trigger && (event.key === "ArrowDown" || event.key === "Enter" || event.key === " ")) {
      event.preventDefault();
      const pillarId = trigger.dataset.menuTrigger!;
      if (state.openMenu !== pillarId) openMenu(pillarId);
      menuOptions(pillarId)[0]?.focus();
      return;
    }

    if (!state.openMenu) return;
    const options = menuOptions(state.openMenu);
    const current = target.closest<HTMLButtonElement>("[data-cat-toggle]");
    const index = current ? options.indexOf(current) : -1;
    if (index < 0) return;

    if (event.key === "ArrowDown") {
      event.preventDefault();
      options[(index + 1) % options.length]?.focus();
    } else if (event.key === "ArrowUp") {
      event.preventDefault();
      options[(index - 1 + options.length) % options.length]?.focus();
    } else if (event.key === "Home") {
      event.preventDefault();
      options[0]?.focus();
    } else if (event.key === "End") {
      event.preventDefault();
      options[options.length - 1]?.focus();
    }
  });

  el.dialog.addEventListener("close", () => {
    if (state.selectedId) closeDetail();
  });

  el.dialog.addEventListener("click", (event) => {
    if (event.target === el.dialog) el.dialog.close();
  });

  desktopQuery.addEventListener("change", () => {
    if (state.selectedId) closeDetail({ restoreFocus: false });
  });

  function syncStickyOffsets() {
    const header = document.querySelector(".site-header");
    if (!header) return;
    document.documentElement.style.setProperty(
      "--week-header-h",
      `${Math.round(header.getBoundingClientRect().height)}px`,
    );
  }

  renderFilters();
  render();
  syncStickyOffsets();

  let resizeFrame: number | null = null;
  window.addEventListener("resize", () => {
    if (resizeFrame) cancelAnimationFrame(resizeFrame);
    resizeFrame = requestAnimationFrame(syncStickyOffsets);
  });
</script>
