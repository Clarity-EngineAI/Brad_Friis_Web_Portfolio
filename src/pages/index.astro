---
import { Image } from "astro:assets";
import SiteLayout from "../layouts/SiteLayout.astro";
import ContactPanel from "../components/ContactPanel.astro";
import { isStackedLogo, logos } from "../data/logos";
import { letters } from "../data/letters";

const capabilities = [
  {
    id: "sales",
    title: "Sales Growth",
    summary: "Pipeline, proposals, close",
    body: "Full-cycle selling from prospecting to close: lead generation, demos, written proposals, conference selling, Pipedrive pipeline management and renewal forecasting.",
    evidence: "Six written references cover the commercial record, customers and managers alike.",
  },
  {
    id: "adoption",
    title: "Product Adoption",
    summary: "Signed contract to everyday use",
    body: "Built adoption strategy, enablement workshops and stakeholder communication so software moved from signed contract to everyday use.",
    evidence: "Andrew Bergh: even the most hesitant became confident users.",
  },
  {
    id: "ai",
    title: "AI & Product",
    summary: "Commercial workflows and audits",
    body: "Apply AI tooling to commercial workflows, customer experience and product audits, including Pikle positioning, CRM stages, sales assets and UX priorities.",
    evidence: "Positioning, proposal templates, lead channels, a sales kit and UX audit priorities.",
  },
  {
    id: "ux",
    title: "Product & UX",
    summary: "Commercial product judgement",
    body: "Create messaging, brand governance, UI direction and practical kits so teams sell, present and build from one standard.",
    evidence: "UI, UX and customer experience used to sharpen the offer and the path to the buyer.",
  },
];

const work = [
  {
    meta: "SaaS Territory Growth · 2015–2025",
    title: "PowerSchool and Schoology, NZ & Australia",
    body: "Ten years selling, demoing, proposing, forecasting, enabling and supporting a SaaS platform. Licensed users grew from 2,800 to 24,500 while key accounts stayed and expanded.",
    tags: ["Sales", "Product Adoption", "Vendor Enablement", "Proposals", "Forecasting"],
  },
  {
    meta: "AI Product Consulting · 2025–now",
    title: "Pikle commercial and UX build",
    body: "Positioning, pricing, proposal templates, CRM stages, four lead channels, a sales asset kit, UX audit priorities and brand governance for early-stage software work.",
    tags: ["Positioning", "Lead Channels", "CRM Stages", "Sales Kit", "UX Audit"],
  },
  {
    meta: "Sales Operations · 2013–2015",
    title: "99 Corporation revenue system",
    body: "Built the process behind a fourteen-person telemarketing team, plus national-account scoping and the billing structure that held cash flow together.",
    tags: ["Lead Generation", "Telemarketing", "Billing", "National Accounts"],
  },
  {
    meta: "Media and Web Growth",
    title: "CanWest and Xplore growth years",
    body: "Proposals, presentations and pipeline in media, then web strategy where positioning, usability, search and conversion had to line up.",
    tags: ["Proposals", "Presentations", "Pipeline", "UX Strategy", "Major Accounts"],
  },
];

const careers = [
  { title: "Sell the idea before it exists", meta: "1999 · Event director, 2000AD" },
  { title: "Build the market, not just the sale", meta: "2001 · Business development, Adplus Advertising (now Tracta)" },
  { title: "Design the path to the buyer", meta: "2009 · Business development, Xplore" },
  { title: "Build the system behind sellers", meta: "2013 · National sales and marketing, 99 Corporation" },
  { title: "Grow the territory, then keep it growing", meta: "2015 · Sales and Marketing Manager, then General Manager" },
  { title: "Turn AI into commercial systems", meta: "2025 · Independent consultant, Clarity Engine AI and Pikle" },
];

const homeQuotes = [
  {
    quote:
      "At a time when we were seriously considering moving away from Schoology, Brad helped us see the platform in a new light.",
    name: "Adrian Pilgrim",
    relation: "The Industry School · 2025",
    slug: "the-industry-school",
  },
  {
    quote:
      "One of Brad's most remarkable qualities is his ability to support teachers, particularly those resistant to change.",
    name: "Andrew Bergh",
    relation: "High School Principal · June 2025",
    slug: "andrew-bergh",
  },
  {
    quote:
      "Several of Brad's past clients have mentioned his ability a number of years on from his departure.",
    name: "Philip Lemon",
    relation:
      "My manager at CanWest Media · the letterhead is The Radio Network, where he was working by the time he wrote it",
    slug: "canwest-media",
  },
  {
    quote:
      "It is my observation that Brad has assisted with a significant improvement in tourism industry buy-in to the core marketing activities of Hawke's Bay Tourism during this time.",
    name: "Hamish Lowry",
    relation: "General Manager, Hawke's Bay Tourism · February 2003",
    slug: "hawkes-bay-tourism",
  },
];

const pad = (index: number) => String(index + 1).padStart(2, "0");

// Reference numbers must agree with /letters/, where all six are listed.
const letterNumber = (slug: string) => pad(letters.findIndex((letter) => letter.slug === slug));
---

<SiteLayout>
  <div class="band">
    <section class="hero shell">
      <div>
        <p class="eyebrow-pill">Auckland · Commercial roles</p>
        <h1>Brad Friis</h1>
        <p class="hero-copy">Commercial operator for SaaS growth: sales, revenue systems, product adoption and AI enablement.</p>
        <ul class="tag-list" aria-label="Commercial capabilities">
          <li>Sales Growth</li>
          <li>SaaS Strategy</li>
          <li>Revenue Systems</li>
          <li>Product Adoption</li>
          <li>AI Enablement</li>
        </ul>
        <div class="hero-actions">
          <a class="button" href="#contact">Contact Brad</a>
          <a class="text-link" href="/cv/">View CV</a>
        </div>
        <p class="trust-line">Six written references · published in full, named people</p>
      </div>
      <div class="hero-aside">
        <figure class="portrait-well">
          <p class="monogram" aria-hidden="true">BF</p>
          <p class="status-chip">
            <strong>Available for commercial roles</strong>
            <span>Auckland, New Zealand</span>
          </p>
          <figcaption>Portrait to come.</figcaption>
        </figure>
      </div>
    </section>
  </div>

  <div class="proof-band">
    <div class="proof-strip shell" aria-label="Commercial proof summary">
      <div><strong>2,800 → 24,500</strong><span>Licensed users, NZ and Australia</span></div>
      <div><strong>Six references</strong><span>Customers and managers, 2003–2025</span></div>
      <div><strong>Full-cycle sales</strong><span>Prospect, propose, close, adopt, renew</span></div>
    </div>
  </div>

  <div class="band">
    <section class="section shell" aria-labelledby="capabilities-heading">
      <header class="section-head">
        <p class="eyebrow-pill">About Me</p>
        <h2 id="capabilities-heading">Sell it, then make it stick.</h2>
        <p class="lead">Pipeline, proposals, adoption strategy, AI-enabled systems. All of it starts with understanding the customer.</p>
      </header>

      <div class="pill-tablist" role="tablist" aria-label="Capabilities" aria-orientation="horizontal">
        {capabilities.map((capability, index) => (
          <button
            class="pill-tab"
            type="button"
            role="tab"
            id={`tab-${capability.id}`}
            aria-controls={`panel-${capability.id}`}
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? 0 : -1}
          >
            {capability.title}
          </button>
        ))}
      </div>

      <div class="capability-stack">
        {capabilities.map((capability, index) => (
          <article
            class="capability-panel"
            id={`panel-${capability.id}`}
            role="tabpanel"
            aria-labelledby={`tab-${capability.id}`}
            hidden={index !== 0}
          >
            <p class="enum">{pad(index)}</p>
            <h3>{capability.title}</h3>
            <p class="tier-meta">{capability.summary}</p>
            <p>{capability.body}</p>
            <p class="evidence">{capability.evidence}</p>
          </article>
        ))}
      </div>
    </section>
  </div>

  <div class="band band-alt">
    <section class="section shell" id="work" aria-labelledby="work-heading">
      <header class="section-head">
        <p class="eyebrow-pill">Work</p>
        <h2 id="work-heading">The system is the proof.</h2>
        <p class="lead">Demand, pipeline, proposals, adoption. Then AI, product and UX. The whole revenue path.</p>
      </header>
      <div class="hairline-grid">
        {work.map((item, index) => (
          <article class="work-cell">
            <p class="enum">{pad(index)}</p>
            <h3>{item.title}</h3>
            <p class="meta">{item.meta}</p>
            <p>{item.body}</p>
            <ul class="chip-list" aria-label={`${item.title} capabilities`}>
              {item.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="shell logo-strip" aria-labelledby="logos-heading">
      <p class="eyebrow-pill" id="logos-heading">Brands I've sold to and worked with · 1999–2025</p>
      <p class="logo-note">Past accounts and employers across the media, agency and software years. Not current clients, and not an endorsement.</p>
      <ul aria-label="Companies Brad has sold to and worked with">
        {logos.map((logo) => (
          <li>
            <Image
              class:list={{ "logo-stacked": isStackedLogo(logo) }}
              src={logo.image}
              alt={logo.name}
              height={isStackedLogo(logo) ? 80 : 60}
              loading="lazy"
            />
          </li>
        ))}
      </ul>
    </section>
  </div>

  <div class="band band-invert">
    <section class="section shell" aria-labelledby="references-heading">
      <header class="section-head">
        <p class="eyebrow-pill">References</p>
        <h2 id="references-heading">Six people put it in writing.</h2>
        <p class="lead">Named, dated, published in full. Every quote links to the document it came from.</p>
      </header>
      <div class="hairline-grid">
        {homeQuotes.map((item) => (
          <article class="quote-cell">
            <p class="enum">{letterNumber(item.slug)}</p>
            <blockquote>“{item.quote}”</blockquote>
            <div class="attribution">
              <p class="tier-name">{item.name}</p>
              <p class="tier-meta">{item.relation}</p>
            </div>
            <a class="text-link" href={`/letters/${item.slug}/`}>Read this letter</a>
          </article>
        ))}
      </div>
      <p class="section-link"><a class="text-link" href="/letters/">Read all six references</a></p>
    </section>
  </div>

  <div class="band">
    <section class="section shell" aria-labelledby="career-heading">
      <header class="section-head">
        <p class="eyebrow-pill">Career</p>
        <h2 id="career-heading">The range came one job at a time.</h2>
        <p class="lead">Generate demand. Shape the offer. Close the work. Enable users. Then grow the account.</p>
      </header>
      <ol class="row-list">
        {careers.map((item, index) => (
          <li class="career-row">
            <p class="enum">{pad(index)}</p>
            <div>
              <p class="tier-name">{item.title}</p>
              <p class="tier-meta">{item.meta}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="section-link"><a class="text-link" href="/cv/">View the full CV</a></p>
    </section>
  </div>

  <div class="band band-alt">
    <section class="section shell" id="contact" aria-labelledby="contact-heading">
      <ContactPanel />
    </section>
  </div>
</SiteLayout>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".pill-tab"));
  const panels = Array.from(document.querySelectorAll<HTMLElement>(".capability-panel"));

  function selectTab(tab: HTMLButtonElement) {
    tabs.forEach((item) => {
      const isSelected = item === tab;
      item.setAttribute("aria-selected", String(isSelected));
      item.tabIndex = isSelected ? 0 : -1;
    });

    panels.forEach((panel) => {
      panel.hidden = panel.id !== tab.getAttribute("aria-controls");
    });
  }

  tabs.forEach((tab, index) => {
    tab.addEventListener("click", () => selectTab(tab));
    tab.addEventListener("keydown", (event) => {
      if (!["ArrowRight", "ArrowLeft", "ArrowDown", "ArrowUp", "Home", "End"].includes(event.key)) return;
      event.preventDefault();

      let nextIndex = index;
      if (event.key === "ArrowRight" || event.key === "ArrowDown") nextIndex = (index + 1) % tabs.length;
      if (event.key === "ArrowLeft" || event.key === "ArrowUp") nextIndex = (index - 1 + tabs.length) % tabs.length;
      if (event.key === "Home") nextIndex = 0;
      if (event.key === "End") nextIndex = tabs.length - 1;

      const nextTab = tabs[nextIndex];
      if (!nextTab) return;
      selectTab(nextTab);
      nextTab.focus();
    });
  });
</script>
