---
import SiteLayout from "../layouts/SiteLayout.astro";

const capabilities = [
  {
    id: "sales",
    title: "Sales Growth",
    summary: "Pipeline, proposals, close",
    body: "Full-cycle selling from prospecting to close: lead generation, demos, written proposals, conference selling, Pipedrive pipeline management and renewal forecasting.",
    evidence: "Six written references support the commercial record across customers and managers.",
  },
  {
    id: "adoption",
    title: "Product Adoption",
    summary: "Signed contract to everyday use",
    body: "Built adoption strategy, enablement workshops and stakeholder communication so software moved from signed contract to everyday use.",
    evidence: "Andrew Bergh: even the most hesitant became confident users.",
  },
  {
    id: "ai",
    title: "AI & Product",
    summary: "Commercial workflows and audits",
    body: "Apply AI tooling to commercial workflows, customer experience and product audits, including Pikle positioning, CRM stages, sales assets and UX priorities.",
    evidence: "Applied work includes positioning, proposal templates, lead channels, a sales kit and UX audit priorities.",
  },
  {
    id: "ux",
    title: "Product & UX",
    summary: "Commercial product judgement",
    body: "Create messaging, brand governance, UI direction and practical kits so teams sell, present and build from one standard.",
    evidence: "UI, UX and customer experience are used here to strengthen the offer and the path to the buyer.",
  },
];

const work = [
  {
    meta: "SaaS Territory Growth · 2015–2025",
    title: "PowerSchool and Schoology, NZ & Australia",
    body: "Ten years selling, demoing, proposing, forecasting, enabling and supporting a SaaS platform. Licensed users grew from 2,800 to 24,500 while key accounts stayed and expanded.",
    tags: ["Sales", "Product Adoption", "Vendor Enablement", "Proposals", "Forecasting"],
  },
  {
    meta: "AI Product Consulting · 2025–now",
    title: "Pikle commercial and UX build",
    body: "Built positioning, pricing, proposal templates, CRM stages, four lead channels, a sales asset kit, UX audit priorities and brand/design governance for early-stage software work.",
    tags: ["Positioning", "Lead Channels", "CRM Stages", "Sales Kit", "UX Audit"],
  },
  {
    meta: "Sales Operations · 2013–2015",
    title: "99 Corporation revenue system",
    body: "Built the process behind a fourteen-person telemarketing team, including national-account scoping and a billing structure that held cash flow together.",
    tags: ["Lead Generation", "Telemarketing", "Billing", "National Accounts"],
  },
  {
    meta: "Media and Web Growth · 2005–2013",
    title: "Canwest and Xplore growth years",
    body: "Proposals, presentations and pipeline in media, then web strategy where positioning, usability, search and conversion had to line up.",
    tags: ["Proposals", "Presentations", "Pipeline", "UX Strategy", "Major Accounts"],
  },
];

const careers = [
  ["1999", "Sell the idea before it exists"],
  ["2001", "Build the market, not just the sale"],
  ["2005", "Turn ideas into proposals that win"],
  ["2009", "Design the path to the buyer"],
  ["2013", "Build the system behind sellers"],
  ["2015", "Grow the territory, then keep it growing"],
  ["2025", "Turn AI into commercial systems"],
];
---

<SiteLayout>
  <section class="hero shell">
    <div>
      <p class="eyebrow">Auckland · Commercial roles</p>
      <h1>Brad Friis</h1>
      <p class="hero-copy">Commercial operator for SaaS growth: sales, revenue systems, product adoption and AI enablement.</p>
      <ul class="tag-list" aria-label="Commercial capabilities">
        <li>Sales Growth</li>
        <li>SaaS Strategy</li>
        <li>Revenue Systems</li>
        <li>Product Adoption</li>
        <li>AI Enablement</li>
      </ul>
      <div class="hero-actions">
        <a class="button" href="mailto:brad@clarityengine.co">Contact Brad</a>
        <a class="text-link" href="/cv/">View CV</a>
      </div>
      <p class="trust-line">Six written references · named people, in their own words</p>
    </div>
    <aside class="hero-proof" aria-label="SaaS territory growth">
      <p class="section-label">Ten-year SaaS territory</p>
      <strong>2,800 → 24,500</strong>
      <p>Licensed users across New Zealand and Australia.</p>
    </aside>
  </section>

  <div class="proof-strip" aria-label="Commercial proof summary">
    <div><strong>2,800 → 24,500</strong><span>Licensed users, NZ and Australia</span></div>
    <div><strong>Six references</strong><span>Customers and managers, 2003–2025</span></div>
    <div><strong>Full-cycle sales</strong><span>Prospect, propose, close, adopt, renew</span></div>
  </div>

  <section class="section shell" aria-labelledby="capabilities-heading">
    <header class="section-heading">
      <div>
        <p class="section-label">About Me</p>
        <h2 id="capabilities-heading">Sell, Build, Enable</h2>
      </div>
      <p>I turn customer understanding into pipeline, proposals, adoption strategy and practical AI-enabled systems.</p>
    </header>

    <div class="workspace">
      <div class="workspace-tabs" role="tablist" aria-label="Capabilities" aria-orientation="vertical">
        {capabilities.map((capability, index) => (
          <button
            class="workspace-tab"
            type="button"
            role="tab"
            id={`tab-${capability.id}`}
            aria-controls={`panel-${capability.id}`}
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? 0 : -1}
          >
            {capability.title}
            <small>{capability.summary}</small>
          </button>
        ))}
      </div>
      <div>
        {capabilities.map((capability, index) => (
          <article
            class:list={["workspace-panel", { "is-active": index === 0 }]}
            id={`panel-${capability.id}`}
            role="tabpanel"
            aria-labelledby={`tab-${capability.id}`}
            hidden={index !== 0}
          >
            <h3>{capability.title}</h3>
            <p>{capability.body}</p>
            <p class="evidence">{capability.evidence}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section shell" id="work" aria-labelledby="work-heading">
    <header class="section-heading">
      <div>
        <p class="section-label">Work</p>
        <h2 id="work-heading">The Commercial System</h2>
      </div>
      <p>Proof across the whole revenue path: demand, pipeline, proposals, adoption, AI, product and UX.</p>
    </header>
    <div class="work-grid">
      {work.map((item) => (
        <article class="work-card">
          <p class="meta">{item.meta}</p>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
          <ul class="chip-list" aria-label={`${item.title} capabilities`}>
            {item.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="section shell" aria-labelledby="references-heading">
    <header class="section-heading">
      <div>
        <p class="section-label">References</p>
        <h2 id="references-heading">People Say</h2>
      </div>
      <p>Written references make the work checkable. These excerpts link to the named reference record.</p>
    </header>
    <div class="quote-grid">
      <article class="quote-card">
        <blockquote>“At a time when we were considering moving away from Schoology, Brad helped us see the platform's potential and gave us the confidence to invest further.”</blockquote>
        <cite>Adrian Pilgrim, The Industry School</cite>
      </article>
      <article class="quote-card">
        <blockquote>“Brad's most remarkable quality is his ability to support teachers resistant to change. Even the most hesitant became confident users.”</blockquote>
        <cite>Andrew Bergh, High School Principal</cite>
      </article>
    </div>
    <p class="section-link"><a class="text-link" href="/letters/">Read the references</a></p>
  </section>

  <section class="section shell" aria-labelledby="career-heading">
    <header class="section-heading">
      <div>
        <p class="section-label">Career</p>
        <h2 id="career-heading">Commercial Range</h2>
      </div>
      <p>Generate demand, shape the offer, close the work, enable users, manage the pipeline and grow the account.</p>
    </header>
    <ol class="career-list">
      {careers.map(([year, title]) => (
        <li><time>{year}</time><span>{title}</span></li>
      ))}
    </ol>
    <p class="section-link"><a class="text-link" href="/cv/">View the full CV</a></p>
  </section>

  <section class="section shell" id="contact" aria-labelledby="contact-heading">
    <div class="contact-panel">
      <div>
        <p class="section-label">Contact Me</p>
        <h2 id="contact-heading">Start a Conversation</h2>
        <p>Sales Growth · SaaS · Revenue Systems · Product Adoption · AI</p>
      </div>
      <a class="button" href="mailto:brad@clarityengine.co">brad@clarityengine.co</a>
    </div>
  </section>
</SiteLayout>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".workspace-tab"));
  const panels = Array.from(document.querySelectorAll<HTMLElement>(".workspace-panel"));
  const mobileQuery = window.matchMedia("(max-width: 650px)");

  function selectTab(tab: HTMLButtonElement) {
    tabs.forEach((item) => {
      const isSelected = item === tab;
      item.setAttribute("aria-selected", String(isSelected));
      item.tabIndex = isSelected ? 0 : -1;
    });

    panels.forEach((panel) => {
      const isActive = panel.id === tab.getAttribute("aria-controls");
      panel.hidden = mobileQuery.matches ? false : !isActive;
      panel.classList.toggle("is-active", isActive);
    });
  }

  function syncPanels() {
    const selectedTab = tabs.find((tab) => tab.getAttribute("aria-selected") === "true") ?? tabs[0];
    panels.forEach((panel) => {
      panel.hidden = mobileQuery.matches ? false : panel.id !== selectedTab.getAttribute("aria-controls");
    });
  }

  tabs.forEach((tab, index) => {
    tab.addEventListener("click", () => selectTab(tab));
    tab.addEventListener("keydown", (event) => {
      if (!["ArrowDown", "ArrowUp", "Home", "End"].includes(event.key)) return;
      event.preventDefault();

      let nextIndex = index;
      if (event.key === "ArrowDown") nextIndex = (index + 1) % tabs.length;
      if (event.key === "ArrowUp") nextIndex = (index - 1 + tabs.length) % tabs.length;
      if (event.key === "Home") nextIndex = 0;
      if (event.key === "End") nextIndex = tabs.length - 1;

      const nextTab = tabs[nextIndex];
      selectTab(nextTab);
      nextTab.focus();
    });
  });

  mobileQuery.addEventListener("change", syncPanels);
  syncPanels();
</script>
