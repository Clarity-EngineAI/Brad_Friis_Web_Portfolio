---
import { Image } from "astro:assets";
import SiteLayout from "../layouts/SiteLayout.astro";
import ContactPanel from "../components/ContactPanel.astro";
import BookingButton from "../components/BookingButton.astro";
import { logos } from "../data/logos";
import { aiLogos } from "../data/aiLogos";
import portrait from "../assets/brad-friis.jpg";

// Every figure traces to `COPY/brad-verified-claims-transcript.md`.
// Nothing here is extrapolated, and the disputed Visitor Guide figures never appear.
const stats = [
  { figure: "8 years", label: "Consecutive renewals, one account" },
  { figure: "2.8K → 24.5K", label: "Licensed users, NZ and Australia" },
  { figure: "+30%", label: "Lift in initial client investment" },
  { figure: "10 years", label: "Holding the vendor channel relationship" },
];

const capabilities = [
  {
    id: "strategic",
    title: "Read the business before pitching it anything",
    summary: "Strategy after the ground, not instead of it",
    body: "A multi-campus account was evaluating a move away from the platform. I spent a week on-site with teachers and leadership at every campus before writing a strategy, then went back to teach it. The account renewed, added a sixth campus, and bought two revenue lines that hadn't existed there before.",
    evidence: "Hamish Lowry, Hawke's Bay Tourism: “an individual with integrity; plus the drive and dedication to reach and exceed sales targets.”",
  },
  {
    id: "creative",
    title: "Find the offer nobody has priced yet",
    summary: "New revenue lines from work already being done",
    body: "Support was being given away inside the software licence, so I made it a paid managed-services line, billed annually in advance, worth around $40,000 to $50,000 a year. The same instinct founded a referral network at Xplore and shaped a two-tier product at Adplus.",
    evidence: "Philip Lemon: “quickly became known for thinking outside of the square and for creating new and untapped opportunities for his clients.”",
  },
  {
    id: "retention",
    title: "Keep accounts, not just win them",
    summary: "Renewals proved over years, not claimed",
    body: "Eight consecutive years of renewal at one school. 108 one-to-one interviews with teachers through COVID lockdowns, to keep adoption alive when nobody could run a workshop in a room. The Hawke's Bay Chamber of Commerce held as a client for four years, essentially the whole tenure.",
    evidence: "Hamish Lowry, Hawke's Bay Tourism: “Brad ensured that service excellence was paramount and clearly recognised its vital importance in the highly competitive marketplace of today.”",
  },
  {
    id: "commercial",
    title: "Own the terms, not just the relationship",
    summary: "Contracts negotiated, not accepted",
    body: "When a vendor cancelled the channel agreement, I negotiated its replacement personally: buy-as-needed pricing, no upfront cost, and the right to invoice schools directly in local currency, plus a 50% deposit structure at 99 Corporation that changed the business's cashflow.",
    evidence: "Rob Nieuwland: the deposit change made “a massive difference to cashflow and operations.”",
  },
  {
    id: "product",
    title: "Know the product, not just the pitch",
    summary: "The piece that makes the rest of it work",
    body: "MySimpleSiteMan taught me the hard way that knowing how to use a tool isn't the same as the tool working for the customer. Every role since has meant going deep on the product: localising US course material for NZ schools, designing an SIS integration, and this past year, working fluency with AI tools to find where they actually save a business time.",
    evidence: "Pranesh Lad: “your deep knowledge has been key to solving every issue we've thrown your way.”",
  },
];

const graphicEras = [
  { year: "2001", label: "Ad revenue up 60% in 3 years" },
  { year: "2009", label: "$70k site, agency's biggest yet" },
  { year: "2013", label: "30% more profit per customer" },
  { year: "2015", label: "2,800 users to 24,500" },
];

const workCaseStudies = [
  {
    meta: "Multi-campus account · retention under pressure · 2015–2025",
    title: "The account that was leaving, then grew",
    body: "A multi-campus account was actively evaluating a move away from the platform. I spent a week on the ground, rebuilt the adoption strategy campus by campus, and went back to teach it. The account stayed, then expanded.",
    evidence: "Adrian Pilgrim, Teaching and Learning Manager: “at a time when we were seriously considering moving away from Schoology, Brad helped us see the platform in a new light.”",
    link: { href: "/letters/the-industry-school/", label: "Adrian's reference letter" },
  },
  {
    meta: "108 one-to-one interviews · COVID-19 lockdowns · 2020",
    title: "Adoption doesn't scale, so I stopped scaling it",
    body: "Lockdowns cut off the workshop model that normally carries adoption. I ran 108 individual interviews with teachers instead: the slow, expensive method, for the accounts that mattered most.",
    evidence: "Andrew Bergh, High School Principal: “it is difficult to overstate the impact Brad has had on my previous school and the broader community of Schoology schools in New Zealand.”",
    link: { href: "/letters/andrew-bergh/", label: "Andrew's reference letter" },
  },
  {
    meta: "Founder · MySimpleSiteMan, 2006–2009",
    title: "The one that taught me the difference",
    body: "I founded and ran a self-serve website builder for small businesses, priced at $399 a year. Over $400,000 went into it before I closed it down. I had misjudged that small-business owners understood how to build a site that actually converted a visitor. Knowing how to use a tool isn't the same as the tool working for the customer.",
    evidence: "The one time I've failed, and the lesson every role since has been built on.",
    // The only card whose pill points at a blog post rather than a referee letter — this is the
    // one story with no third party to vouch for it, so the long version does the vouching.
    link: { href: "/blog/simplesiteman/", label: "Read the story" },
  },
  {
    meta: "Channel contract renegotiation · 2020",
    title: "The contract that made the decade possible",
    body: "When the channel agreement was cancelled, in a pandemic-driven platform change rather than a performance issue, I negotiated its replacement directly: no upfront cost, and the right to invoice customers myself.",
    evidence: "Gavin Jeffries, Senior Account Director – Asia, PowerSchool: “your deep PowerSchool expertise and strong connections across our team, long-standing relationships with Schoology customers in New Zealand and Australia, and the trust you've built have all added significant value to our presence in the Oceania market.”",
    link: { href: "/letters/powerschool/", label: "Gavin's reference" },
  },
];

const careers = [
  // Brad's spine, 18 August 2026: year, then the role, then the organisation, each on its own
  // line. Replaces the single `meta` string that was split on " \u00b7 " at render time — three
  // distinct fields render as three lines without the markup guessing where the break goes.
  {
    year: "1999",
    role: "Event director",
    org: "2000AD",
    title: "Sold sponsorship before the event existed",
    // Brad's figures, confirmed 19 August 2026. 13,000 is his correction to the 15,000 recorded in
    // `design/archive/05-younger-years-edit-prompt.md`; the archive is now annotated to match.
    // The BBC line is hedged to the negotiation, which is the part Brad owns, rather than
    // asserting what aired: it is the one claim here a reader could go and check. "First to see
    // the sun" is likewise attributed to the pitch, not stated as fact — several places claimed it
    // at the millennium and the argument is not one this page needs to win.
    detail: "A full year producing the largest private millennium event in New Zealand. 13,000 people, two stages, an all-New Zealand lineup. I sold the naming rights to DB for the ten seconds of laser at midnight, and negotiated with the BBC to carry the event as part of their global millennium programme, pitched on New Zealand being first in the world to see the sun.",
  },
  {
    year: "2001",
    role: "Business development",
    org: "Adplus Advertising, later Tracta",
    title: "Held the flagship account personally",
    detail: "Sold website add-on modules on monthly recurring fees after site builds: image galleries, FAQs, news tickers. The Hawke's Bay Visitor Guide account grew ad revenue 60% and advertiser volume 40% over three years, and stayed mine throughout.",
    // Walker was the managing director of Adplus, so his verdict belongs on the Adplus row and
    // nowhere else: it needs no explaining here. Brad chose the sentence; see
    // `COPY/letters/quote-bank.md`. The row's detail is all figures, so this is the one line on it
    // about the person rather than the account. 19 August 2026.
    quote: {
      text: "People with Brad's skill do not come along every day.",
      attribution: "Andy Walker, Managing Director",
      slug: "adplus-advertising",
    },
  },
  {
    year: "2003",
    role: "Sales & account management",
    org: "Canwest, RadioWorks",
    title: "Kept the national account for three years",
    detail: "Held the Harvey Norman account for the full three years I was at Canwest Media. Don't recall losing an account in that time.",
    teaser: { href: "/blog/plastic-bags/", label: "Observations: door-knocking started long before this, the plastic bags" },
  },
  {
    year: "2009",
    role: "Business development",
    org: "Xplore web agency",
    title: "Turned one-off projects into repeat work",
    detail: "Sold SEO packages and add-on modules on monthly recurring fees. Founded Xchange, a referral network of 25 businesses, and collected over $70,000 from it across two years.",
  },
  {
    year: "2013",
    role: "National sales & marketing",
    org: "99 Corporation",
    title: "Put a price on previously unbilled work",
    detail: "Rob Nieuwland, who owned the business: profit per customer up around 30% and business clients up around 70% during my tenure.",
  },
  {
    year: "2015",
    role: "Sales & Marketing Manager,\nthen General Manager",
    // "PowerSchool channel partner", Brad's call 18 August 2026, after the unnamed-vendor
    // framing was put to him. Names the product line without claiming the employer: Brad sold
    // PowerSchool products as the vendor's local channel partner, he was not employed by
    // PowerSchool, and the bare name would collapse on a reference check. The employer itself
    // stays unnamed per [[gct-never-named]].
    org: "PowerSchool channel partner, education",
    title: "Ran every function that touches the customer",
    stages: [
      { stage: "Demand", detail: "Sales strategy, two appointment-booking websites, conference stands and presenting, direct-marketing campaigns." },
      { stage: "Land", detail: "Implementation and onboarding." },
      { stage: "Keep", detail: "Created and delivered training, live workshops and self-paced material, plus support MSAs." },
      { stage: "Grow", detail: "Financial strategy and channel-partner contract negotiation, including a full reseller agreement renegotiated personally." },
    ],
  },
  {
    year: "2025",
    role: "Independent upskilling",
    org: "AI business systems",
    title: "Take AI fluency into the account, not the headline",
    // Pikle removed on Brad's instruction, 18 August 2026. The two released builds (Whirling
    // Design GPT, poultry scraping tool) are stronger evidence per
    // COPY/interviews/2-consultant-clarity-pikle.md, but putting them on the page is new copy
    // and therefore Brad's call, not mine.
    detail: "A year of hands-on work with AI tools, finding where they save a business real time.",
  },
];

// The three 2025 letters. The other three, all pre-2006, still publish at /letters/.
// These sentences are deliberately NOT the `pullQuote` values in `src/data/letters.ts` — the
// homepage and the letters index previously showed identical text. Each is verbatim, checked
// against the letter body in that same file.
// Brad chose these from `COPY/letters/quote-bank.md`, 19 August 2026. Lad was added to break the
// third instance of the Pilgrim/Bergh repetition: the same two sentences had been carrying the
// capability cards, the case studies and this section at once. Do not substitute a different
// sentence from the letters without asking him — that is the fault the quote bank exists to stop.
const homeQuotes = [
  {
    quote:
      "This clarity and customisation shifted our thinking, giving us the confidence not only to stay with Schoology, but to invest in getting the very best from it.",
    name: "Adrian Pilgrim",
    relation: "Teaching and Learning Manager, The Industry School · 2025",
    slug: "the-industry-school",
  },
  {
    quote:
      "His empathetic and proactive approach ensures that even the most hesitant team members became confident users of Schoology.",
    name: "Andrew Bergh",
    relation: "High School Principal · June 2025",
    slug: "andrew-bergh",
  },
  {
    // Two adjacent paragraphs in the source letter, joined. The hyphen and the smiley are both
    // verbatim: this is the only unsolicited document in the archive and it reads like one.
    quote:
      "Working with you is always a pleasure - your professionalism and positive attitude make everything so much smoother. You're a real star, Brad :)",
    name: "Pranesh Lad",
    relation: "IT Systems Engineer, Rototuna High Schools · May 2025",
    slug: "rototuna-high-schools",
  },
];

---

<SiteLayout>
  <div class="band">
    <section class="hero shell">
      <div>
        <p class="eyebrow-pill">Account management</p>
        <h1>I win, grow and renew accounts.</h1>
        <p class="hero-copy">I run key accounts end to end: I learn the customer’s business, find where they’re leaving value on the table, and put a solution in front of them that renews and grows.</p>
        <div class="hero-actions">
          {/* Booking is the filled button and the form is outlined, not the other way
              round: a booking is a committed action, a contact form is a maybe. Attribute
              8 allows exactly one accent fill, so only one of these two can be filled. */}
          <BookingButton variant="hero" />
          <a class="button button-secondary" href="#contact">Send a message</a>
        </div>
      </div>
      <div class="hero-aside">
        <figure class="portrait-well">
          <Image
            class="portrait"
            src={portrait}
            alt="Brad Friis"
            widths={[340, 680]}
            sizes="(max-width: 900px) 100vw, 340px"
            loading="eager"
          />
          <figcaption class="status-chip">
            <strong>Available for commercial roles</strong>
            <span>Auckland, New Zealand</span>
          </figcaption>
        </figure>
      </div>
    </section>
  </div>

  <div class="stat-band">
    <div class="stat-strip shell" aria-label="Commercial results">
      {stats.map((stat) => (
        <div class="stat">
          <p class="stat-figure">{stat.figure}</p>
          <p class="stat-label">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>

  <div class="band">
    <section class="section shell" aria-labelledby="capabilities-heading">
      <header class="section-head">
        <p class="eyebrow-pill">How I work</p>
        <h2 id="capabilities-heading">Five parts to my method.</h2>
        <p class="lead">Read the business, find the priced-wrong offer, keep what I win, own the terms, and know the product well enough to trust the pitch.</p>
      </header>

      <div class="hairline-grid capability-grid">
        {capabilities.map((capability) => (
          <article class="capability-cell">
            <h3>{capability.title}</h3>
            <p class="tier-meta">{capability.summary}</p>
            <p>{capability.body}</p>
            <p class="evidence">{capability.evidence}</p>
          </article>
        ))}
      </div>
    </section>
  </div>

  <div class="band band-alt">
    <section class="section shell motion-strip" aria-labelledby="motion-heading">
      <header class="section-head">
        <p class="eyebrow-pill">Four businesses, four eras</p>
        <h2 id="motion-heading">Growth in every era.</h2>
        <p class="lead">Four different businesses, four different products. The same result each time.</p>
      </header>
      <ol class="motion-track" aria-label="Growth by era">
        {graphicEras.map((era) => (
          <li class="motion-node">
            <span class="motion-year">{era.year}</span>
            <span class="motion-label">{era.label}</span>
          </li>
        ))}
      </ol>
    </section>
  </div>

  <div class="band">
    <section class="section shell" id="work" aria-labelledby="work-heading">
      <header class="section-head section-head-left">
        <p class="eyebrow-pill">Work</p>
        <h2 id="work-heading">The claim proved four times.</h2>
        <p class="lead">Four concrete moments. Each ends with a number or a named voice the reader can verify.</p>
      </header>
      <div class="hairline-grid">
        {workCaseStudies.map((item) => (
          <article class="work-cell">
            <p class="meta">{item.meta}</p>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            {item.evidence && <p class="evidence">{item.evidence}</p>}
            {item.link && <a class="letter-pill" href={item.link.href}>{item.link.label}</a>}
          </article>
        ))}
      </div>
    </section>

    <section class="shell logo-strip" aria-labelledby="logos-heading">
      <p class="eyebrow-pill" id="logos-heading">Brands I've sold to and worked with · 1999–2025</p>
      <p class="logo-note">Past accounts and employers across the media, agency and software years. Not current clients, and not an endorsement.</p>
      <ul aria-label="Companies Brad has sold to and worked with">
        {logos.map((logo) => (
          <li>
            <Image src={logo.image} alt={logo.name} height={64} loading="lazy" />
          </li>
        ))}
      </ul>
    </section>
  </div>

  <div class="band band-alt">
    <section class="section shell" aria-labelledby="now-heading">
      <header class="section-head">
        <p class="eyebrow-pill">Right now</p>
        <h2 id="now-heading">A year building AI fluency with the tools.</h2>
        <p class="lead">The past year has been hands-on work with AI tools, the same product-depth habit from the rest of this page applied at a new scale: working fluency with the toolkit, and an eye for where it actually saves a business time.</p>
      </header>

      <div class="shell logo-strip" aria-labelledby="ai-logos-heading">
        <p class="eyebrow-pill" id="ai-logos-heading">Tools in daily use</p>
        <ul aria-label="AI and software tools Brad uses">
          {aiLogos.map((logo) => (
            <li>
              <Image src={logo.image} alt={logo.name} height={64} loading="lazy" />
            </li>
          ))}
        </ul>
      </div>
    </section>
  </div>

  <div class="band">
    <section class="section shell" aria-labelledby="career-heading">
      <header class="section-head section-head-left">
        <p class="eyebrow-pill">Career</p>
        <h2 id="career-heading">The range came one job at a time.</h2>
        <p class="lead">Generate demand. Shape the offer. Close the work. Enable users. Then grow the account.</p>
        <p class="standfirst">I kept the bulk of the accounts I won. Not all of them, and not everywhere, but the billing, the contracts, the renewals and the relationship were mine at every job I have had since 2001.</p>
      </header>
      <ol class="row-list">
        {careers.map((item) => {
          return (
            <li class="career-row">
              <div class="career-spine">
                <p class="career-year">{item.year}</p>
                <p class="career-role">{item.role}</p>
                <p class="career-org">{item.org}</p>
              </div>
              <div>
                <p class="tier-name">{item.title}</p>
                {item.detail && <p class="tier-detail">{item.detail}</p>}
                {item.quote && (
                  <p class="career-quote">
                    <span class="career-quote-text">“{item.quote.text}”</span>
                    <a class="career-quote-source" href={`/letters/${item.quote.slug}/`}>{item.quote.attribution}</a>
                  </p>
                )}
                {item.stages && (
                  <dl class="stage-list">
                    {item.stages.map((s) => (
                      <div class="stage">
                        <dt>{s.stage}</dt>
                        <dd>{s.detail}</dd>
                      </div>
                    ))}
                  </dl>
                )}
                {item.teaser && <a class="text-link" href={item.teaser.href}>{item.teaser.label}</a>}
              </div>
            </li>
          );
        })}
      </ol>
    </section>
  </div>

  <div class="band band-alt">
    <section class="section shell" aria-labelledby="letters-heading">
      <header class="section-head">
        <p class="eyebrow-pill">References</p>
        <h2 id="letters-heading">Six reference letters, published in full.</h2>
        <p class="lead">Three of the six were written in 2025. Two describe an account kept that had a reason to go; the third arrived unasked.</p>
      </header>
      <div class="hairline-grid">
        {homeQuotes.map((item) => (
          <article class="quote-cell">
            <blockquote>“{item.quote}”</blockquote>
            <div class="attribution">
              <p class="tier-name">{item.name}</p>
              <p class="tier-meta">{item.relation}</p>
            </div>
            <a class="text-link" href={`/letters/${item.slug}/`}>Read this letter</a>
          </article>
        ))}
      </div>
      <p class="section-link"><a class="text-link" href="/letters/">Read all six reference letters</a></p>
    </section>
  </div>

  <div class="band">
    <section class="section shell" id="contact" aria-labelledby="contact-heading">
      <ContactPanel />
    </section>
  </div>
</SiteLayout>

