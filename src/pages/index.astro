---
import { Image } from "astro:assets";
import SiteLayout from "../layouts/SiteLayout.astro";
import ContactPanel from "../components/ContactPanel.astro";
import { isStackedLogo, logos } from "../data/logos";
import portrait from "../assets/brad-friis.jpg";

// Every figure traces to `Brad Friis Resumes/bradfriisresumemaster20260806.md`.
// Nothing here is extrapolated, and the disputed Visitor Guide figures never appear.
const stats = [
  { figure: "5 campuses", label: "Account retained mid-defection, then expanded" },
  { figure: "2.8K → 24.5K", label: "Licensed users, NZ and Australia" },
  { figure: "+30%", label: "Lift in initial client investment" },
  { figure: "10 years", label: "Holding the vendor channel relationship" },
];

const capabilities = [
  {
    id: "needs-first",
    title: "I find the need behind the brief",
    summary: "Understand before I pitch",
    body: "Before building a retention strategy for a multi-campus account, I spent a week on the ground learning how each campus actually used the platform, then went back and taught what I found.",
    evidence: "Adrian Pilgrim: “custom strategies and workarounds that fit our operations.”",
  },
  {
    id: "keep-and-grow",
    title: "I keep the account close to its value",
    summary: "Renewals that survive a competitor's pitch",
    body: "Eight consecutive renewals at one school. A multi-campus account that renewed and expanded after evaluating a direct competitor. Renewed through annual price rises — the schools I lost were on total cost, never on the rise alone.",
    evidence: "Andrew Bergh: even the most hesitant teachers became confident users.",
  },
  {
    id: "next-offer",
    title: "I turn gaps into the next offer",
    summary: "New lines from unpriced work",
    body: "Support was being given away, so I made it a paid line, billed annually in advance. The same instinct now applies to positioning, CRM stages and sales assets for early-stage work.",
    evidence: "Managed services scaled with the account, so revenue grew without a new sale each time.",
  },
  {
    id: "terms",
    title: "I make the terms support the work",
    summary: "Own the contract, not just the relationship",
    body: "When a channel contract was cancelled, I negotiated its replacement myself — no upfront cost, and the right to invoice customers directly.",
    evidence: "The accounts were mine to keep because I made them mine to bill.",
  },
];

const workCaseStudies = [
  {
    meta: "Multi-campus account · retention under pressure · 2015–2025",
    title: "The account that was leaving, then grew",
    body: "A multi-campus account was actively evaluating a move away from the platform. I spent a week on the ground, rebuilt the adoption strategy campus by campus, and went back to teach it. The account stayed, then expanded.",
    evidence: "Adrian Pilgrim, Teaching and Learning Manager: “giving us the confidence to invest in the platform further.”",
    link: { href: "/letters/the-industry-school/", label: "Read Adrian Pilgrim's full letter" },
  },
  {
    meta: "National sales and marketing · 99 Corporation, 2013",
    title: "The job nobody was charging for",
    body: "Support was being handled for free, on request, with no line item. I made it a structured, paid service, so it became revenue instead of overhead.",
    // PLACEHOLDER — replace with Rob Nieuwland's letter once received (expected within ~1 week of 17 Aug 2026).
    // Figures are tenure-wide context, not a measurement of this specific pricing change: customer base +55%
    // (Rob Nieuwland, owner, verbal — not yet in writing), income +30% (Brad). See COPY/interviews/0-blockers.md.
    evidence: "During Brad's tenure, 99 Corporation's customer base grew by around 55 per cent and income by around 30 per cent.",
    link: null,
  },
  {
    meta: "Channel contract renegotiation",
    title: "The contract that made the decade possible",
    body: "When the channel agreement was cancelled — a pandemic-driven platform change, not a performance issue — I negotiated its replacement directly: no upfront cost, and the right to invoice customers myself.",
    evidence: "The accounts were mine to keep because I made them mine to bill.",
    link: null,
  },
];

const careers = [
  { title: "Sold sponsorship before the event existed", meta: "1999 · Event director, 2000AD" },
  { title: "Held the flagship account personally", meta: "2001 · Business development, Adplus Advertising (later Tracta)" },
  {
    title: "Kept the national account for three years",
    meta: "2003 · Sales, Canwest Media",
    detail: "I held the Harvey Norman account for the full three years I was at Canwest Media (Radioworks).",
  },
  {
    title: "Turned one-off projects into repeat work",
    meta: "2009 · Business development, Xplore",
    detail: "Customers up around 70 per cent, income up around 120 per cent, in my time there. Rob Nieuwland, who owned the business, puts it differently but the same way: profit from each customer was up around 30 per cent too.",
  },
  { title: "Put a price on previously unbilled work", meta: "2013 · National sales and marketing, 99 Corporation" },
  { title: "Grew the territory and kept key accounts", meta: "2015 · Sales and Marketing Manager, then General Manager" },
  { title: "Turn AI into commercial systems", meta: "2025 · Independent consultant, Clarity Engine AI and Pikle" },
];

// Two 2025 letters only, both proving retention. The other four still publish at /letters/.
// These sentences are deliberately NOT the `pullQuote` values in `src/data/letters.ts` — the
// homepage and the letters index previously showed identical text. Each is a single unbroken
// verbatim sentence, checked against the letter body in that same file.
const homeQuotes = [
  {
    quote:
      "This clarity and customisation shifted our thinking, giving us the confidence not only to stay with Schoology, but to invest in getting the very best from it.",
    name: "Adrian Pilgrim",
    relation: "Teaching and Learning Manager, The Industry School · 2025",
    slug: "the-industry-school",
  },
  {
    quote:
      "His empathetic and proactive approach ensures that even the most hesitant team members became confident users of Schoology.",
    name: "Andrew Bergh",
    relation: "High School Principal · June 2025",
    slug: "andrew-bergh",
  },
];

---

<SiteLayout>
  <div class="band">
    <section class="hero shell">
      <div>
        <p class="eyebrow-pill">Account management</p>
        <h1>I win, grow and renew accounts.</h1>
        <p class="hero-copy">Commercial operator across SaaS, web strategy and revenue systems.</p>
        <div class="hero-actions">
          <a class="button" href="#contact">Start a conversation</a>
          <a class="text-link" href="/cv/">View CV</a>
        </div>
      </div>
      <div class="hero-aside">
        <figure class="portrait-well">
          <Image
            class="portrait"
            src={portrait}
            alt="Brad Friis"
            widths={[340, 680]}
            sizes="(max-width: 900px) 100vw, 340px"
            loading="eager"
          />
          <figcaption class="status-chip">
            <strong>Available for commercial roles</strong>
            <span>Auckland, New Zealand</span>
          </figcaption>
        </figure>
      </div>
    </section>
  </div>

  <div class="stat-band">
    <div class="stat-strip shell" aria-label="Commercial results">
      {stats.map((stat) => (
        <div class="stat">
          <p class="stat-figure">{stat.figure}</p>
          <p class="stat-label">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>

  <div class="band">
    <section class="section shell" aria-labelledby="capabilities-heading">
      <header class="section-head">
        <p class="eyebrow-pill">How I work</p>
        <h2 id="capabilities-heading">Four parts of one method.</h2>
        <p class="lead">Find the real need, keep the account, originate the next offer, and own the terms that make it possible.</p>
      </header>

      <div class="hairline-grid capability-grid">
        {capabilities.map((capability) => (
          <article class="capability-cell">
            <h3>{capability.title}</h3>
            <p class="tier-meta">{capability.summary}</p>
            <p>{capability.body}</p>
            <p class="evidence">{capability.evidence}</p>
          </article>
        ))}
      </div>
    </section>
  </div>

  <div class="band band-alt">
    <section class="section shell" id="work" aria-labelledby="work-heading">
      <header class="section-head">
        <p class="eyebrow-pill">Work</p>
        <h2 id="work-heading">The claim proved three times.</h2>
        <p class="lead">Three concrete stories. Each ends with a number or a named voice the reader can verify.</p>
      </header>
      <div class="hairline-grid">
        {workCaseStudies.map((item) => (
          <article class="work-cell">
            <p class="meta">{item.meta}</p>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            {item.evidence && <p class="evidence">{item.evidence}</p>}
            {item.link && <a class="text-link" href={item.link.href}>{item.link.label}</a>}
          </article>
        ))}
      </div>
    </section>

    <section class="shell logo-strip" aria-labelledby="logos-heading">
      <p class="eyebrow-pill" id="logos-heading">Brands I've sold to and worked with · 1999–2025</p>
      <p class="logo-note">Past accounts and employers across the media, agency and software years. Not current clients, and not an endorsement.</p>
      <ul aria-label="Companies Brad has sold to and worked with">
        {logos.map((logo) => (
          <li>
            <Image
              class:list={{ "logo-stacked": isStackedLogo(logo) }}
              src={logo.image}
              alt={logo.name}
              height={isStackedLogo(logo) ? 80 : 60}
              loading="lazy"
            />
          </li>
        ))}
      </ul>
    </section>
  </div>

  <div class="band">
    <section class="section shell proof-quotes" aria-labelledby="proof-heading">
      <header class="section-head">
        <p class="eyebrow-pill">References</p>
        <h2 id="proof-heading">The customers who nearly left said it themselves.</h2>
        <p class="lead">Both wrote in 2025. Both describe keeping an account that had a reason to go.</p>
      </header>
      <div class="hairline-grid">
        {homeQuotes.map((item) => (
          <article class="quote-cell">
            <blockquote>“{item.quote}”</blockquote>
            <div class="attribution">
              <p class="tier-name">{item.name}</p>
              <p class="tier-meta">{item.relation}</p>
            </div>
            <a class="text-link" href={`/letters/${item.slug}/`}>Read this letter</a>
          </article>
        ))}
      </div>
      <p class="section-link"><a class="text-link" href="/letters/">Read all verified reference letters</a></p>
    </section>
  </div>

  <div class="band">
    <section class="section shell" aria-labelledby="career-heading">
      <header class="section-head">
        <p class="eyebrow-pill">Career</p>
        <h2 id="career-heading">The range came one job at a time.</h2>
        <p class="lead">Generate demand. Shape the offer. Close the work. Enable users. Then grow the account.</p>
        <p class="standfirst">I kept the bulk of the accounts I won. Not all of them, and not everywhere — but the billing, the contracts, the renewals and the relationship were mine at every job I have had since 2001.</p>
      </header>
      <ol class="row-list">
        {careers.map((item) => (
          <li class="career-row">
            <div>
              <p class="tier-name">{item.title}</p>
              <p class="tier-meta">{item.meta}</p>
              {item.detail && <p class="tier-detail">{item.detail}</p>}
            </div>
          </li>
        ))}
      </ol>
      <p class="section-link"><a class="text-link" href="/cv/">View the full CV</a></p>
    </section>
  </div>

  <div class="band band-alt">
    <section class="section shell" id="contact" aria-labelledby="contact-heading">
      <ContactPanel />
    </section>
  </div>
</SiteLayout>

