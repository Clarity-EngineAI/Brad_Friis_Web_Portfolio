---
import "@fontsource-variable/inter";
import "../styles/global.css";
import { bookingEnabled } from "../data/contact";
import { contact } from "../data/contact";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Brad Friis — Commercial operator for SaaS growth",
  description = "Brad Friis builds commercial systems around software growth: sales, revenue systems, product adoption and AI enablement.",
} = Astro.props;

const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site ?? Astro.url).href;

/* Cal.com's loader, verbatim from their element-click embed. It lives here rather than in
   BookingButton so a page carrying two buttons (the homepage: hero and contact panel)
   still fetches embed.js once.

   Passed through `set:html` rather than written as script children: Astro treats JSX
   children of a <script> as text to escape, so a template literal there is emitted with
   its backticks intact and never runs. That is exactly what happened on the first build.

   Not loaded at all when no Cal link is configured — no third-party request from a site
   with no calendar behind it. */
const calLoader = `(function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if (typeof namespace === "string") { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ["initNamespace", namespace]); } else p(cal, ar); return; } p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
Cal("init", { origin: "https://app.cal.com" });`;

/* Microsoft Clarity analytics, verbatim from their tracking snippet. */
const clarityLoader = `(function(c,l,a,r,i,t,y){
    c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
    t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
    y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
})(window, document, "clarity", "script", "y7rk5mm5h9");
Cal("ui", { hideEventTypeDetails: false, layout: "month_view", cssVarsPerTheme: { light: { "cal-brand": "#9c3d1e" } } });`;
---

<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f1ec" />
    <!-- DELIBERATE GATE — do not remove without Brad's explicit sign-off that the copy is
         full and complete. Belt-and-braces with public/robots.txt. -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_NZ" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    {bookingEnabled && <script is:inline set:html={calLoader} />}
    <script is:inline set:html={clarityLoader} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Brad Friis, home">Brad Friis</a>
      <nav class="primary-nav" aria-label="Primary navigation">
        <a href="/#work">Work</a>
        <a href="/blog/" aria-current={path.startsWith("/blog") ? "page" : undefined}>Observations</a>
        <a href="/week/" aria-current={path.startsWith("/week") ? "page" : undefined}>EdTech</a>
        <a href="/letters/" aria-current={path.startsWith("/letters") ? "page" : undefined}>Letters</a>
        <a href="/cv/" aria-current={path.startsWith("/cv") ? "page" : undefined}>CV</a>
        <a class="header-contact" href="/#contact">Contact</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>© 2026 Brad Friis. All rights reserved. {contact.location}.</p>
      <div>
        <a href="/blog/">Observations</a>
        <a href="/letters/">Letters</a>
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
        <a href={contact.phoneHref}>{contact.phone}</a>
        <a href={contact.linkedin} rel="me">LinkedIn</a>
      </div>
    </footer>
  </body>
</html>
